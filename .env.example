# Copy to .env (git-ignored) for local runs. Never commit real project IDs to this public repo.
HIVE_PROJECT=your-gcp-project
HIVE_REGION=us-central1          # Agent Engine / Cloud Run / BigQuery region
HIVE_MODEL_LOCATION=global       # Gemini endpoint location (Flash, Flash-Lite and Argon are served from global)
HIVE_BQ_DATASET=agenthive_demo
HIVE_KB_PREFIX=agenthive-kb      # Vertex AI Search data store id prefix: agenthive-kb-<realm>
# Optional model overrides (defaults in agenthive/models.py)
# HIVE_MODEL_LITE=gemini-3.5-flash-lite
# HIVE_MODEL_FLASH=gemini-3.5-flash
# HIVE_MODEL_ARGON=gemini-4-argon
