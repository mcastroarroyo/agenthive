        "max_total_ha": 3.0,
        "requires_staple_plot": true,
        "requires_verified_identity": true
      },
      "enrol_by": "2027-02-28",
      "benefit": "Seed for up to 1 ha of staples plus 2 bags (45 kg) of fertiliser per hectare, up to 3 ha"
    },
    {
      "code": "FVP",
      "name": "Fertiliser Voucher",
      "summary": "50% voucher on fertiliser at accredited agro-dealers, one voucher per producer per season.",
      "rules": {
        "max_total_ha": 10.0,
        "once_per_season": true
      },
      "enrol_by": "2026-12-31",
      "benefit": "50% of the price of up to 4 bags (45 kg) per hectare, up to 10 ha"
    },
    {
      "code": "PCI",
      "name": "Parametric Crop Insurance",
      "summary": "Rainfall-index insurance; pays automatically when 30-day rainfall falls below 60% of the 20-year average.",
      "rules": {
        "subsidy_pct_small": 70,
        "subsidy_pct_large": 30,
        "small_max_ha": 5.0
      },
      "enrol_by": "2026-12-15",
      "benefit": "Payout up to $350 per insured hectare"
    },
    {
      "code": "CRR",
      "name": "Coffee Renovation Credit",
      "summary": "Credit to renovate rust-affected or old coffee plots through the national development bank.",
      "rules": {
        "crop": "coffee",
        "max_ha": 5.0,
        "per_ha": 2500,
        "rate_pct": 3.0,
        "term_years": 5,
        "grace_years": 2,
        "requires_georeference": true,
        "requires_tenure": [
          "owner_title",
          "lease",
          "usufruct",
          "cooperative"
        ],
        "min_rust_pct": 20,
        "or_min_plant_age_years": 15
      },
      "enrol_by": "2027-03-31",
      "benefit": "Up to $2,500 per hectare at 3% a year, 5 years with 2 years' grace"
    }
