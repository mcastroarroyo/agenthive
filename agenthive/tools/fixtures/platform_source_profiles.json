          {
            "name": "inventory_snapshot",
            "rows": 1583000000,
            "columns": ["snapshot_date date", "store_no int", "sku string", "on_hand_qty int", "on_order_qty int", "in_transit_qty int"],
            "candidate_keys": ["snapshot_date + store_no + sku"]
          },
          {
            "name": "purchase_orders",
            "rows": 388000,
            "columns": ["po_no string", "supplier_id string", "sku string", "ordered_qty int", "order_date date", "expected_date date", "received_date date (nullable)", "dest_store_no int (nullable = DC)"],
            "candidate_keys": ["po_no + sku"]
          }
        ]
      },
      {
        "name": "E-commerce platform",
        "platform": "Hosted e-commerce platform (REST API, 2 req/s rate limit)",
        "extract": "Hourly API pull of orders",
        "tables": [
          {
            "name": "web_orders",
            "rows": 1920000,
            "columns": ["order_id string", "order_ts timestamp (UTC)", "customer_email_hash string", "ship_method (home / click-and-collect)", "pickup_store_no int (nullable)", "order_total numeric", "status string"],
            "candidate_keys": ["order_id"]
          },
          {
            "name": "web_order_lines",
            "rows": 4380000,
            "columns": ["order_id string", "line_no int", "sku string", "qty int", "unit_price numeric"],
            "candidate_keys": ["order_id + line_no"]
          }
        ]
      },
      {
        "name": "Promotions calendar",
        "platform": "Google Sheets maintained by Marketing",
        "extract": "Manual; one tab per season",
        "tables": [
          {
            "name": "promotions",
            "rows": 1460,
            "columns": ["promo_code", "description", "start_date", "end_date", "discount_type (pct / amount / bogo)", "discount_value", "scope (all stores / region / store list)", "sku or class list (comma separated)"],
            "candidate_keys": ["promo_code"]
          }
