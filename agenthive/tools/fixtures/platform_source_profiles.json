{
  "claims": {
    "description": "Regional P&C mutual insurer (~400 employees, ~210k policies, ~38k claims/year). Profiled from read-only extracts, October 2026.",
    "systems": [
      {
        "name": "Core claims system",
        "platform": "Vendor-hosted application on SQL Server 2016 (nightly read replica available)",
        "extract": "Nightly full extract via read replica; CDC not licensed",
        "tables": [
          {
            "name": "CLAIM",
            "rows": 1842310,
            "columns": ["CLAIM_NO varchar(14)", "POLICY_NO varchar(12)", "LOSS_DATE date", "REPORTED_DATE datetime (local time, no TZ)", "LOSS_CAUSE_CD varchar(4)", "LOSS_DESC nvarchar(max) (free text, contains PII)", "CLAIM_STATUS_CD char(2)", "LOB_CD char(3)", "CAT_CODE varchar(6) (catastrophe event, nullable)", "ASSIGNED_ADJ_ID int", "BRANCH_CD char(3)", "CLOSED_DATE datetime (nullable)"],
