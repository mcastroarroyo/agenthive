            "rows": 31408992,
            "columns": ["NOTE_ID bigint", "CLAIM_NO varchar(14)", "NOTE_TS datetime", "AUTHOR_ID int", "NOTE_TEXT nvarchar(max) (free text, PII, medical details)"],
