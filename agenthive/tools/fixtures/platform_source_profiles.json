      }
    ],
    "quality_issues": [
      {"table": "pos_transactions", "issue": "txn_ts is store-local time without zone; 3 time zones across the estate. Use business_date for daily grain.", "severity": "medium"},
      {"table": "pos_transaction_lines", "issue": "Returns are recorded as negative qty in some stores and as txn_type='return' with positive qty in others (two POS versions).", "severity": "high"},
      {"table": "inventory_snapshot", "issue": "Daily snapshot missing for 2.1% of store-days (late SFTP files never re-sent); negative on_hand_qty in 0.6% of rows.", "severity": "high"},
      {"table": "item_master", "issue": "Size/colour variants share style_code but 4% of SKUs have a blank class/subclass; 312 SKUs reused after discontinuation.", "severity": "medium"},
      {"table": "store_master", "issue": "4 closed stores still receive zero-row POS files; 2 stores relocated and kept the same store_no.", "severity": "low"},
      {"table": "promotions", "issue": "Free-text SKU lists in a spreadsheet; overlapping promotions not flagged; history before 2025 incomplete.", "severity": "medium"},
      {"table": "web_orders", "issue": "Click-and-collect orders appear in both web_orders and in the pickup store's POS file (double counting risk).", "severity": "high"}
    ]
  },
