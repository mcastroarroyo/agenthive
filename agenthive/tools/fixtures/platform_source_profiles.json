            "rows": 131400000,
            "columns": ["store_no int", "register_no int", "txn_no int", "business_date date", "txn_ts timestamp (store local)", "txn_type (sale / return / void)", "customer_loyalty_id string (nullable)", "total_amount numeric", "tender_type string"],
