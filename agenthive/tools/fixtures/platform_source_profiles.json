          },
          {
            "name": "INSURED_PARTY",
            "rows": 268410,
            "columns": ["PARTY_ID number", "PARTY_TYPE char(1) (person / organisation)", "FULL_NAME varchar2(160)", "DOB date", "TAX_ID_HASH varchar2(64)", "MAIL_ADDR varchar2(200)", "ZIP varchar2(10)"],
            "candidate_keys": ["PARTY_ID"]
          }
        ]
      },
      {
        "name": "Document management",
        "platform": "On-premises document management server (metadata in SQL Server, files on NAS)",
        "extract": "Metadata via SQL; files via SMB copy",
        "tables": [
          {
            "name": "DOC_INDEX",
            "rows": 9612004,
            "columns": ["DOC_ID bigint", "CLAIM_NO varchar(14) (nullable)", "POLICY_NO varchar(12) (nullable)", "DOC_TYPE varchar(20) (photo, estimate, letter, police report, medical...)", "MIME_TYPE varchar(40)", "PAGES int", "HAS_TEXT_LAYER bit", "STORED_TS datetime", "PATH nvarchar(400)"],
            "candidate_keys": ["DOC_ID"]
          }
        ]
      },
      {
        "name": "Adjuster roster",
        "platform": "Excel workbook on a file share (manually maintained by Claims Operations)",
        "extract": "Manual upload",
        "tables": [
          {
            "name": "adjusters.xlsx / Roster",
            "rows": 74,
            "columns": ["Adjuster ID", "Name", "Team", "Region", "Authority limit ($)", "Start date", "Status (active / leave / left)"],
            "candidate_keys": ["Adjuster ID"]
          }
        ]
      }
    ],
    "quality_issues": [
      {"table": "CLAIMANT", "issue": "Same person stored under multiple CLAIMANT_IDs across claims (est. 11% duplicates by name + DOB + ZIP); no master party id shared with INSURED_PARTY.", "severity": "high"},
      {"table": "CLAIM", "issue": "REPORTED_DATE and all status timestamps are local time without time zone; 3 branches are in a different time zone.", "severity": "medium"},
      {"table": "CLAIM", "issue": "0.4% of claims have LOSS_DATE after REPORTED_DATE (keying errors, mostly 2014-2016).", "severity": "low"},
      {"table": "CLAIM", "issue": "CLAIM_STATUS_CD values changed in the 2019 re-platforming ('RO' re-opened vs 'RE'); mapping table exists only in an email thread.", "severity": "medium"},
      {"table": "CLAIM / CLAIM_NOTE", "issue": "Free-text LOSS_DESC and NOTE_TEXT contain names, phone numbers, medical details and occasionally full SSNs; must be de-identified or restricted before analytics or AI use.", "severity": "high"},
      {"table": "POLICY_COVERAGE", "issue": "WORDING_VERSION null for 18% of coverages written before 2015; policy wording cannot be resolved automatically for those claims.", "severity": "medium"},
      {"table": "DOC_INDEX", "issue": "61% of documents are scanned PDFs or images without a text layer (OCR required); 2.3% of PATH values point to missing files.", "severity": "high"},
      {"table": "adjusters.xlsx", "issue": "Roster is manually maintained; 9 ASSIGNED_ADJ_ID values in CLAIM have no match in the roster (departed staff).", "severity": "low"}
    ]
  },
  "retail": {
    "description": "Specialty outdoor retailer with 120 open stores (124 in master data incl. 4 closed) and e-commerce. Profiled from 24 months of extracts.",
    "systems": [
      {
