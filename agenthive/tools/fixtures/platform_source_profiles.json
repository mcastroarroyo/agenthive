          {
            "name": "CLAIMANT",
            "rows": 2295004,
            "columns": ["CLAIMANT_ID int", "CLAIM_NO varchar(14)", "PARTY_TYPE_CD char(2) (insured / third party / witness)", "FIRST_NM nvarchar(60)", "LAST_NM nvarchar(80)", "DOB date", "SSN_LAST4 char(4)", "PHONE varchar(20)", "EMAIL varchar(120)", "ADDR_LINE1 nvarchar(120)", "ZIP varchar(10)"],
            "candidate_keys": ["CLAIMANT_ID"]
          },
          {
            "name": "EXPOSURE",
            "rows": 2610455,
            "columns": ["EXPOSURE_ID int", "CLAIM_NO varchar(14)", "COVERAGE_CD varchar(6)", "EXPOSURE_TYPE_CD varchar(4) (dwelling, contents, auto PD, BI...)", "RESERVE_AMT decimal(12,2)", "OPENED_DATE date", "CLOSED_DATE date (nullable)"],
            "candidate_keys": ["EXPOSURE_ID"]
          },
          {
            "name": "CLAIM_PAYMENT",
            "rows": 4120877,
            "columns": ["PAYMENT_ID bigint", "EXPOSURE_ID int", "CLAIM_NO varchar(14)", "PAYMENT_DATE date", "PAYMENT_AMT decimal(12,2)", "PAYMENT_TYPE_CD char(2) (indemnity / expense / recovery)", "PAYEE_NM nvarchar(120)", "CHECK_NO varchar(12)"],
            "candidate_keys": ["PAYMENT_ID"]
          },
          {
            "name": "CLAIM_STATUS_HIST",
            "rows": 9876120,
            "columns": ["CLAIM_NO varchar(14)", "STATUS_CD char(2)", "STATUS_TS datetime (local time)", "CHANGED_BY varchar(30)"],
            "candidate_keys": ["CLAIM_NO + STATUS_TS"]
