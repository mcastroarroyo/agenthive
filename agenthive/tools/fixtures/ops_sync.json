  "stage_maps": {
    "hubspot": {"appointmentscheduled": "prospect", "qualifiedtobuy": "qualified", "presentationscheduled": "qualified", "contractsent": "contracting", "closedwon": "won", "closedlost": "lost"},
    "salesforce": {"Prospecting": "prospect", "Qualification": "qualified", "Proposal/Price Quote": "qualified", "Negotiation/Review": "contracting", "Closed Won": "won", "Closed Lost": "lost"},
    "procore": {"Bidding": "pre_construction", "Pre-Construction": "pre_construction", "Course of Construction": "construction", "Post-Construction": "closeout", "Warranty": "warranty"}
  },
  "mappings": {
    "hubspot.deals": [
      {"source": "hs_object_id", "target": "Opportunity.opportunity_id", "transform": "prefix 'HS-'", "confidence": 1.0},
      {"source": "dealname", "target": "Opportunity.name", "transform": "trim", "confidence": 1.0},
      {"source": "amount", "target": "Opportunity.amount_usd", "transform": "currency → USD using deal_currency_code", "confidence": 0.95},
      {"source": "dealstage", "target": "Opportunity.stage", "transform": "stage_map:hubspot", "confidence": 0.9},
      {"source": "closedate", "target": "Opportunity.close_date", "transform": "epoch ms → DATE", "confidence": 1.0},
      {"source": "associatedcompanyid", "target": "Opportunity.account_id", "transform": "lookup Account via HS company id", "confidence": 0.85},
      {"source": "project_code", "target": "Opportunity.project_code", "transform": "upper + validate 'PRJ-####'", "confidence": 0.9},
      {"source": "hubspot_owner_id", "target": "Opportunity.owner_ref", "transform": "owner directory lookup", "confidence": 0.8},
      {"source": "hs_lastmodifieddate", "target": "Opportunity.source_updated_at", "transform": "to TIMESTAMP UTC", "confidence": 1.0}
    ],
    "hubspot.companies": [
      {"source": "hs_object_id", "target": "Account.account_id", "transform": "prefix 'HS-'", "confidence": 1.0},
      {"source": "name", "target": "Account.name", "transform": "trim + legal-suffix normalisation", "confidence": 0.95},
      {"source": "domain", "target": "Account.domain", "transform": "lowercase", "confidence": 1.0},
      {"source": "industry", "target": "Account.industry", "transform": "industry code map", "confidence": 0.7},
      {"source": "city", "target": "Account.city", "transform": "copy", "confidence": 1.0}
    ],
    "salesforce.Opportunity": [
      {"source": "Id", "target": "Opportunity.opportunity_id", "transform": "prefix 'SF-'", "confidence": 1.0},
      {"source": "Name", "target": "Opportunity.name", "transform": "trim", "confidence": 1.0},
      {"source": "Amount", "target": "Opportunity.amount_usd", "transform": "currency → USD using CurrencyIsoCode", "confidence": 0.95},
      {"source": "StageName", "target": "Opportunity.stage", "transform": "stage_map:salesforce", "confidence": 0.9},
      {"source": "CloseDate", "target": "Opportunity.close_date", "transform": "copy (DATE)", "confidence": 1.0},
      {"source": "AccountId", "target": "Opportunity.account_id", "transform": "prefix 'SF-' + Account match", "confidence": 0.85},
      {"source": "Project_Code__c", "target": "Opportunity.project_code", "transform": "upper + validate 'PRJ-####'", "confidence": 0.95},
      {"source": "OwnerId", "target": "Opportunity.owner_ref", "transform": "owner directory lookup", "confidence": 0.8},
      {"source": "LastModifiedDate", "target": "Opportunity.source_updated_at", "transform": "to TIMESTAMP UTC", "confidence": 1.0}
    ],
    "salesforce.Account": [
      {"source": "Id", "target": "Account.account_id", "transform": "prefix 'SF-'", "confidence": 1.0},
      {"source": "Name", "target": "Account.name", "transform": "trim + legal-suffix normalisation", "confidence": 0.95},
      {"source": "Website", "target": "Account.domain", "transform": "extract host, lowercase", "confidence": 0.9},
      {"source": "Industry", "target": "Account.industry", "transform": "industry code map", "confidence": 0.7},
      {"source": "BillingCity", "target": "Account.city", "transform": "copy", "confidence": 1.0}
    ],
    "procore.projects": [
      {"source": "project_number", "target": "Project.project_code", "transform": "upper + validate 'PRJ-####'", "confidence": 1.0},
      {"source": "name", "target": "Project.name", "transform": "trim", "confidence": 1.0},
      {"source": "stage", "target": "Project.stage", "transform": "stage_map:procore", "confidence": 0.9},
      {"source": "total_value", "target": "Project.contract_value_usd", "transform": "copy (USD)", "confidence": 0.95},
      {"source": "start_date", "target": "Project.start_date", "transform": "copy (DATE)", "confidence": 1.0},
      {"source": "completion_date", "target": "Project.completion_date", "transform": "copy (DATE)", "confidence": 1.0},
      {"source": "address", "target": "Project.site_address", "transform": "concat street, city, postcode", "confidence": 0.9},
      {"source": "updated_at", "target": "Project.source_updated_at", "transform": "to TIMESTAMP UTC", "confidence": 1.0}
    ],
    "procore.change_orders": [
      {"source": "id", "target": "ChangeOrder.change_order_id", "transform": "prefix 'PC-'", "confidence": 1.0},
      {"source": "project_id", "target": "ChangeOrder.project_code", "transform": "lookup projects.project_number", "confidence": 0.95},
      {"source": "number", "target": "ChangeOrder.number", "transform": "copy", "confidence": 1.0},
      {"source": "status", "target": "ChangeOrder.status", "transform": "lowercase", "confidence": 1.0},
      {"source": "grand_total", "target": "ChangeOrder.amount_usd", "transform": "copy (USD)", "confidence": 0.95},
      {"source": "approved_at", "target": "ChangeOrder.approved_at", "transform": "to TIMESTAMP UTC", "confidence": 1.0}
    ]
  },
  "unmapped": {
    "hubspot.deals": ["pipeline", "deal_currency_code (used in transform only)", "site_address (custom property; Procore is master)"],
