  "canonical_model": {
    "Opportunity": ["opportunity_id", "name", "amount_usd", "stage", "close_date", "account_id", "project_code", "owner_ref", "source_system", "source_updated_at"],
    "Account": ["account_id", "name", "domain", "industry", "city"],
