      {"id": "R-CI-03", "risk": "Accounting connector or SSO depends on customer IT change windows", "likelihood": 3, "impact": 3, "mitigation": "Request change windows at kickoff; prepare fallback CSV export", "owner_role": "Implementation Consultant"},
      {"id": "R-CI-04", "risk": "Go-live collides with the customer's peak season", "likelihood": 3, "impact": 5, "mitigation": "Fixed go-live date with 2-week buffer; phased branch rollout", "owner_role": "Project sponsor"},
      {"id": "R-CI-05", "risk": "Technician adoption of the mobile app is low after go-live", "likelihood": 3, "impact": 4, "mitigation": "Ride-alongs in week 1, branch champions, adoption dashboard in hypercare", "owner_role": "Customer Success Manager"},
      {"id": "R-CI-06", "risk": "Scope creep — custom reports and forms requested late", "likelihood": 4, "impact": 3, "mitigation": "Change-control log; reports after go-live phase 2", "owner_role": "Project manager"},
      {"id": "R-CI-07", "risk": "Legacy system support ends before cutover", "likelihood": 2, "impact": 5, "mitigation": "Plan cutover at least 3 months before end of support", "owner_role": "Project sponsor"}
    ],
