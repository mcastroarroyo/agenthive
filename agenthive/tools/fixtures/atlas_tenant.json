  "findings": [
    {"id": "PF-01", "check": "litigation_hold", "severity": "critical", "departments": ["legal", "finance", "executive"], "count": 24, "title": "24 mailboxes on litigation hold", "detail": "Legal 18, Finance 4, Executive 2 custodians. Holds must exist in Google Vault before these users cut over; source holds stay in place for 90 days after cutover.", "remediation": "Create Vault matter KES-LIT-01 with holds for all 24 custodians; Legal sign-off before the wave's go/no-go.", "owner": "Hannah Cho (General Counsel) + Wursta migration lead", "status": "open"},
    {"id": "PF-02", "check": "oversized_mailboxes", "severity": "high", "departments": ["executive", "sales", "legal", "finance", "engineering", "marketing", "supply_chain"], "count": 18, "title": "18 mailboxes over 50 GB (largest 96 GB / 1.1M items)", "detail": "Large mailboxes take 4-6 days to bulk-copy and dominate wave duration.", "remediation": "Pre-stage oversized mailboxes 21 days before their wave; ask owners to archive items older than 7 years.", "owner": "Wursta migration lead", "status": "in_progress"},
    {"id": "PF-03", "check": "pst_files", "severity": "medium", "departments": ["*"], "count": 214, "title": "214 PST files (1.36 TB) found on file shares", "detail": "PST ingestion is out of scope in SOW-2026-0412 (section 4, item OOS-02). Files would be copied to Shared drives as opaque blobs.", "remediation": "Exclude *.pst from share transfer; decide on change order CO for PST ingestion or user self-import.", "owner": "Megan Hollis (client PM)", "status": "open"},
    {"id": "PF-04", "check": "long_paths", "severity": "high", "departments": ["engineering"], "count": 18420, "title": "18,420 files with paths over 400 characters (Engineering CAD tree)", "detail": "The migration agent cannot read these paths reliably; they fail with path_too_long.", "remediation": "Map the share root two levels deeper (\\\\KES-FS01\\Engineering\\Projects) or shorten folder names before the bulk pass.", "owner": "Ingrid Solberg (VP Engineering) + Wursta cloud engineer", "status": "open"},
    {"id": "PF-05", "check": "broken_inheritance", "severity": "high", "departments": ["finance", "legal", "hr"], "count": 7485, "title": "7,485 folders with unique (non-inherited) permissions", "detail": "Shared drives grant access at drive level; restricted sub-folders need their own shared drive or a limited-access folder.", "remediation": "Restructure: one shared drive per restricted area (Finance 6, Legal 4, HR 3 proposed).", "owner": "Wursta solutions architect", "status": "in_progress"},
    {"id": "PF-06", "check": "everyone_full_control", "severity": "critical", "departments": ["hr"], "count": 1, "title": "'Everyone: Full control' on the HR share root", "detail": "Would map to domain-wide editor access in Drive.", "remediation": "Remove the ACE at source and re-scan before the HR wave.", "owner": "Kestrel IT", "status": "resolved", "resolved_on": "2026-10-02"},
    {"id": "PF-07", "check": "orphaned_sids", "severity": "low", "departments": ["*"], "count": 2870, "title": "2,870 ACL entries point to deleted accounts (orphaned SIDs)", "detail": "Cannot be mapped to Google identities.", "remediation": "Dropped during transfer and logged in the permission audit.", "owner": "Wursta migration lead", "status": "accepted"},
    {"id": "PF-08", "check": "blocked_file_types", "severity": "low", "departments": ["it", "engineering"], "count": 3940, "title": "3,940 executable / installer files (.exe, .msi, .bat)", "detail": "Excluded by policy; kept on the source server read-only.", "remediation": "Exclude by extension filter; IT keeps a software repository on Cloud Storage if needed.", "owner": "Kestrel IT", "status": "accepted"},
    {"id": "PF-09", "check": "oversize_items", "severity": "medium", "departments": ["*"], "count": 3812, "title": "3,812 mail items over the 25 MB per-item limit", "detail": "Skipped and reported; users keep read-only access through the source mailbox for 90 days.", "remediation": "Report per user in the post-migration validation; no action unless the user requests export.", "owner": "Wursta migration lead", "status": "accepted"},
    {"id": "PF-10", "check": "shared_mailboxes", "severity": "medium", "departments": ["*"], "count": 37, "title": "37 shared mailboxes", "detail": "Mapped to Google Groups collaborative inboxes (32) or delegated accounts (5, need send-as).", "remediation": "Create groups and delegations in the wave before the members cut over.", "owner": "Wursta cloud engineer", "status": "in_progress"},
    {"id": "PF-11", "check": "resource_mailboxes", "severity": "low", "departments": ["*"], "count": 58, "title": "58 room and equipment mailboxes", "detail": "46 rooms and 12 equipment resources.", "remediation": "Created as Calendar resources with building ids (done in W0).", "owner": "Wursta cloud engineer", "status": "resolved", "resolved_on": "2026-10-09"},
    {"id": "PF-12", "check": "dynamic_distribution_lists", "severity": "low", "departments": ["*"], "count": 6, "title": "6 dynamic distribution lists", "detail": "No 1:1 equivalent; recreate as dynamic groups by department/location attributes.", "remediation": "Recreate as dynamic groups; 182 static lists map 1:1 to Google Groups.", "owner": "Wursta cloud engineer", "status": "resolved", "resolved_on": "2026-10-08"},
    {"id": "PF-13", "check": "smtp_relay_apps", "severity": "high", "departments": ["*"], "count": 7, "title": "7 applications relay mail through Exchange", "detail": "ERP invoicing, CRM quote notifications, HR system, monitoring, 3 multifunction printers. 5 of 7 reconfigured and tested.", "remediation": "Configure the SMTP relay service with IP allowlist; test CRM notifications (Sales wave) and HR system (done).", "owner": "Megan Hollis (client PM)", "status": "in_progress"},
    {"id": "PF-14", "check": "public_folders", "severity": "medium", "departments": ["customer_service"], "count": 1, "title": "Public folder tree (42 GB) used by Customer Service", "detail": "Public folders are out of scope in SOW-2026-0412 (OOS-01).", "remediation": "Client decision: archive read-only, or change order to migrate into a shared drive / group archive.", "owner": "Megan Hollis (client PM)", "status": "open"},
    {"id": "PF-15", "check": "mobile_devices", "severity": "medium", "departments": ["*"], "count": 690, "title": "690 mobile devices syncing with ActiveSync", "detail": "Devices must be re-added with a Google account; hands-on re-enrolment is out of scope (guide only).", "remediation": "Publish the mobile guide at T-3 and staff floorwalkers on Monday.", "owner": "Noor Haddad (Wursta change lead)", "status": "in_progress"},
