    "code": {
     "file": "order_processor/tools.py",
     "source": "def build_row(order: dict, customer: dict, tracking_url: str) -> dict:\n    \"\"\"Build one support-sheet row: date, order, customer, status, tracking link, LTV and VIP flag.\n\n    Args:\n        order: Order from shopify_admin.get_order.\n        customer: Customer from shopify_admin.get_customer (Admin API 2025-10 schema).\n        tracking_url: Carrier tracking link, or an empty string when the order is unfulfilled.\n\n    Returns:\n        status and the row values in sheet-column order.\n    \"\"\"\n    ltv = float(customer.get(\"totalSpent\") or 0)\n    return {\"status\": \"ok\", \"row\": [order[\"processedAt\"][:10], order[\"name\"], customer[\"email\"],\n                                    order[\"displayFulfillmentStatus\"], tracking_url,\n                                    {\"value\": ltv, \"format\": \"currency\"}, \"VIP\" if ltv > 1000 else \"\"]}\n"
    }
   }
