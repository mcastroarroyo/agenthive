     "source": "def email_weekly_summary(to: str, week_start: str, totals: list[dict]) -> dict:\n    \"\"\"Email the service manager the weekly bay-time totals per technician (Mondays 07:00 America/Chicago).\n\n    Args:\n        to: Service manager email.\n        week_start: ISO date of the Monday that starts the reported week.\n        totals: Rows with technician, clocked_hours, billed_hours and utilisation_pct.\n\n    Returns:\n        status and the Gmail message id.\n    \"\"\"\n    body = \"\\n\".join(f\"{t['technician']}: {t['billed_hours']:.1f} billed / {t['clocked_hours']:.1f} clocked\"\n                     for t in totals)\n    draft = gmail.create_draft(to=to, subject=f\"Bay time - week of {week_start}\", body=body)\n    sent = gmail.send_message(draft[\"id\"])\n    return {\"status\": \"ok\", \"message_id\": sent[\"id\"]}\n"
    }
