      "op": "<=",
      "x_uln": 2.5,
      "window_days": 14,
      "alt_if": {
       "condition": "liver metastas",
       "x_uln": 5
      }
     }
    },
    {
     "id": "I7f",
     "type": "inclusion",
     "text": "Total bilirubin <= 1.5 x ULN (within 14 days)",
     "rule": {
      "kind": "measurement",
      "test": "Total bilirubin",
