     "rule": {
      "kind": "washout",
      "categories": [
       "systemic_chemotherapy",
       "systemic_immunotherapy",
       "targeted_therapy",
       "investigational"
      ],
      "days": 21
     }
    },
    {
     "id": "E4",
     "type": "exclusion",
     "text": "Radiotherapy within 14 days before first dose",
     "rule": {
      "kind": "washout",
      "categories": [
       "radiotherapy"
      ],
      "days": 14
     }
    },
    {
