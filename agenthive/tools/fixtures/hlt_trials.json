      "classes": [
       "kras_g12c_inhibitor"
      ]
     }
    },
    {
     "id": "E2",
     "type": "exclusion",
     "text": "Active or untreated brain metastases (treated and stable >= 4 weeks allowed)",
     "rule": {
      "kind": "brain_mets",
