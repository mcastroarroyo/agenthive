 "trials": [
  {
   "trial_id": "CVH-ONC-2026-014",
   "short_name": "HERON-2",
   "title": "Phase II study of HRX-417 in previously treated KRAS G12C-mutated advanced NSCLC",
   "phase": "II",
   "sponsor": "Helix Ridge Therapeutics (fictional)",
   "intervention": "HRX-417, investigational oral KRAS G12C inhibitor (fictional)",
   "condition": "Advanced non-small cell lung cancer with KRAS G12C mutation",
   "condition_keywords": [
    "non-small cell lung cancer",
    "nsclc"
   ],
   "status": "recruiting",
   "site": "Corvina General Hospital \u2014 Cancer Institute",
   "pi": "Dr. Anouk Verhagen (synthetic)",
   "coordinator": "Lior Batista, CRC (synthetic)",
   "slots_remaining": 6,
   "screening_window_days": 28,
   "criteria": [
    {
     "id": "I1",
     "type": "inclusion",
     "text": "Age 18 years or older",
     "rule": {
      "kind": "age",
      "min": 18
     }
    },
    {
     "id": "I2",
     "type": "inclusion",
     "text": "Histologically confirmed NSCLC, stage IIIB-IV or recurrent",
     "rule": {
      "kind": "diagnosis",
      "any_of": [
       "non-small cell lung cancer",
       "nsclc"
      ],
      "stages": [
       "IIIB",
       "IIIC",
       "IV",
       "IVA",
       "IVB",
       "recurrent"
      ]
     }
    },
    {
     "id": "I3",
     "type": "inclusion",
     "text": "KRAS G12C mutation documented by a validated test",
     "rule": {
      "kind": "biomarker",
      "gene": "KRAS",
      "variant": "G12C"
     }
    },
    {
     "id": "I4",
     "type": "inclusion",
     "text": "At least 1 prior line of systemic therapy for advanced disease",
     "rule": {
      "kind": "fact_min",
      "field": "prior_systemic_lines",
      "value": 1
     }
    },
    {
     "id": "I5",
     "type": "inclusion",
     "text": "ECOG performance status 0-1",
     "rule": {
      "kind": "fact_max",
      "field": "ecog",
      "value": 1
     }
    },
    {
     "id": "I6",
     "type": "inclusion",
     "text": "Measurable disease per RECIST 1.1 (lesion >= 10 mm) on imaging within 28 days",
     "rule": {
      "kind": "imaging",
      "min_lesion_mm": 10,
      "window_days": 28
     }
    },
    {
     "id": "I7a",
     "type": "inclusion",
     "text": "ANC >= 1.5 x10^9/L (labs within 14 days)",
     "rule": {
      "kind": "measurement",
      "test": "ANC",
      "op": ">=",
      "value": 1.5,
      "window_days": 14
     }
    },
    {
     "id": "I7b",
     "type": "inclusion",
     "text": "Platelets >= 100 x10^9/L (labs within 14 days)",
     "rule": {
      "kind": "measurement",
      "test": "Platelets",
      "op": ">=",
      "value": 100,
      "window_days": 14
     }
    },
    {
     "id": "I7c",
     "type": "inclusion",
     "text": "Haemoglobin >= 9 g/dL (labs within 14 days)",
     "rule": {
      "kind": "measurement",
      "test": "Hemoglobin",
      "op": ">=",
      "value": 9,
      "window_days": 14
     }
    },
    {
     "id": "I7d",
     "type": "inclusion",
     "text": "Creatinine clearance >= 50 mL/min (labs within 14 days)",
     "rule": {
      "kind": "measurement",
      "test": "Creatinine clearance",
      "op": ">=",
      "value": 50,
      "window_days": 14
     }
    },
    {
     "id": "I7e",
     "type": "inclusion",
     "text": "AST and ALT <= 2.5 x ULN (<= 5 x ULN with liver metastases), within 14 days",
     "rule": {
      "kind": "measurement",
      "test": [
       "AST",
       "ALT"
