     "rule": {
      "kind": "measurement",
      "test": "QTcF",
      "op": "<=",
      "value": 470,
      "window_days": 28
     }
    },
    {
     "id": "E6",
     "type": "exclusion",
     "text": "Active hepatitis B or C, or uncontrolled HIV infection",
     "rule": {
      "kind": "serology",
      "tests": [
       "HBV",
       "HCV",
       "HIV"
      ]
     }
    },
    {
     "id": "E7",
     "type": "exclusion",
     "text": "History of interstitial lung disease or pneumonitis requiring steroids",
     "rule": {
      "kind": "absent_history",
      "any_of": [
       "interstitial lung disease",
       "pneumonitis"
      ]
     }
    },
    {
     "id": "E8",
     "type": "exclusion",
     "text": "Strong CYP3A4 inducers within 14 days",
     "rule": {
      "kind": "med_class_absent",
      "classes": [
       "strong_cyp3a4_inducer"
      ],
      "washout_days": 14
     }
    },
    {
     "id": "E9",
     "type": "exclusion",
     "text": "Pregnant or breastfeeding (negative pregnancy test within 7 days if of childbearing potential)",
     "rule": {
      "kind": "pregnancy",
      "window_days": 7
     }
    }
   ]
